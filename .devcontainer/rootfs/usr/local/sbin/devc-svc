#!/bin/bash
# devc-svc — zarządzanie usługami kontenera (root, przez sudo; D17: jedno z dwóch poleceń dozwolonych w sudoers).
#
#   sudo devc-svc status
#   sudo devc-svc restart <usługa>
#   sudo devc-svc logs <usługa> [liczba-linii]
#
# <usługa> = jedna z WŁĄCZONYCH (DEV_SERVICES) — albo „supervisord” / „<usługa>-init” dla logs.
# Argumenty są walidowane ściśle (nazwy z listy, liczby) — nic nie trafia do powłoki ani do ścieżek bez sprawdzenia.
set -euo pipefail
umask 022
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8
cd /

usage() {
    cat >&2 <<'EOF'
użycie: sudo devc-svc status
        sudo devc-svc restart <usługa>
        sudo devc-svc logs <usługa> [liczba-linii ≤ 5000]
usługi: mssql mariadb phpmyadmin rabbitmq mailpit (tylko włączone w DEV_SERVICES)
EOF
    exit 2
}

if [ "$(id -u)" -ne 0 ]; then echo "devc-svc: uruchom przez sudo (sudo devc-svc …)" >&2; exit 1; fi

# shellcheck source=../lib/devc/services.sh
. /usr/local/lib/devc/services.sh

valid_service() {   # nazwa ze znanej listy ORAZ włączona
    [[ "$1" =~ ^[a-z]{1,20}$ ]] || return 1
    devc_is_known "$1" || return 1
    devc_service_enabled "$1"
}

cmd="${1:-}"
case "${cmd}" in
    status)
        [ $# -eq 1 ] || usage
        if ! devc_supervisor_running; then echo "supervisord nie działa (usługi wyłączone lub kontener w trakcie startu)"; exit 3; fi
        devc_supervisorctl status || true
        ;;
    restart)
        [ $# -eq 2 ] || usage
        svc="$2"
        valid_service "${svc}" || { echo "devc-svc: nieznana lub wyłączona usługa: ${svc}" >&2; exit 2; }
        devc_supervisor_running || { echo "devc-svc: supervisord nie działa — uruchom: sudo /usr/local/sbin/container-init.sh" >&2; exit 3; }
        devc_load_env >/dev/null
        devc_supervisorctl restart "${svc}"
        if "${svc}_ready"; then echo "${svc}: gotowe"; else echo "${svc}: nie osiągnął gotowości (sudo devc-svc logs ${svc})" >&2; exit 1; fi
        ;;
    logs)
        [ $# -ge 2 ] && [ $# -le 3 ] || usage
        name="$2"; lines="${3:-200}"
        [[ "${lines}" =~ ^[0-9]{1,4}$ ]] && [ "${lines}" -ge 1 ] && [ "${lines}" -le 5000 ] || usage
        case "${name}" in
            supervisord|init) file="${DEVC_LOG}/${name}.log" ;;
            dnsmasq) file=/var/log/devc-dnsmasq/dnsmasq.log ;;   # zapytania DNS (tylko DEVC_FIREWALL_MODE=log)
            firewall) devc_load_env >/dev/null; iptables -S; echo; ipset list devc-allow | head -n "${lines}"; exit 0 ;;
            *-init) base="${name%-init}"; devc_is_known "${base}" || usage; file="${DEVC_LOG}/${name}.log" ;;
            *) valid_service "${name}" || { echo "devc-svc: nieznana lub wyłączona usługa: ${name}" >&2; exit 2; }
               file="${DEVC_LOG}/${name}.log" ;;
        esac
        [ -f "${file}" ] || { echo "(brak logu ${file})"; exit 0; }
        tail -n "${lines}" -- "${file}"
        ;;
    *) usage ;;
esac
